# Physics Generator - Local Development Environment
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=physics
POSTGRES_PASSWORD=physics_dev
POSTGRES_DB=physics_generator
POSTGRES_PORT=5432

# Connection string used by Rust engine (SeaORM)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Rust Engine ────────────────────────────────────────────
RUST_LOG=info
API_PORT=3001
ROCKS_DB_PATH=./data/theorems.db

# ── Frontend ───────────────────────────────────────────────
VITE_API_URL=http://localhost:${API_PORT}
VITE_STRIPE_SPONSOR_PAYMENT_LINK=https://buy.stripe.com/REPLACE_ME

# ── LLM cluster steerer (latest GLM via DigitalOcean Gradient) ──
# Server-owned key (NOT exposed to clients). When unset, the daemon
# boots with `STEERER_DISABLED=1` semantics: the GA runs unsteered,
# /api/seed still serves last-known-good config. Get a Gradient key
# at https://cloud.digitalocean.com/account/api/genai
GRADIENT_API_KEY=
# Optional explicit model pin. Leave unset to auto-select the newest
# GLM-family model from Gradient's live /v1/models catalog.
# STEERER_MODEL=glm-5.2
# Used only if model-catalog probing fails or no GLM model is present.
GRADIENT_GLM_MODEL_FALLBACK=glm-5.2
# Cache the auto-selected GLM model so restarts do not repeatedly hit
# Gradient's model catalog. Set to 0 to re-query on every boot.
GRADIENT_MODEL_CACHE_TTL_SECONDS=86400
# Optional override; default is ~/.local/share/nasrudin-worker/gradient_steerer_model.json
# GRADIENT_MODEL_CACHE_PATH=/absolute/path/to/gradient_steerer_model.json
# RL + bandit refresh cadence (seconds). This keeps cluster-level
# exploration updates responsive without changing strategy cost.
STEERER_CADENCE_SECONDS=600
# LLM strategy refresh cadence (seconds). Defaults to 7200 (2 hours):
# run a fresh SteeringConfig this often, but still run RL updates every
# STEERER_CADENCE_SECONDS.
LLM_STEER_INTERVAL_SECONDS=7200
# Hard LLM spend guardrails per strategy refresh. The daemon estimates
# prompt tokens before calling Gradient and refuses the refresh if it
# cannot fit under the total budget; RL/GA keep running on cached strategy.
LLM_STEER_MAX_TOTAL_TOKENS=10000
LLM_STEER_MAX_COMPLETION_TOKENS=2048
# Rolling provider-usage ledger window for the hard LLM spend cap.
# Defaults to LLM_STEER_INTERVAL_SECONDS. Actual provider-reported
# prompt+completion tokens in cluster_steering must fit inside this
# window before a new strategy refresh is allowed.
# LLM_STEER_ROLLING_WINDOW_SECONDS=7200
# Spend LLM tokens only when the RL/GA workhorse has produced fresh
# evidence in the rolling window. Enabled by default: the 2h interval is
# an upper bound, not an obligation to call Gradient.
# LLM_STEER_REQUIRE_NEW_EVIDENCE=1
# Minimum worker cluster-report telemetry needed before an LLM strategy
# refresh is worth spending. Set to 0 to disable this evidence gate.
# LLM_STEER_MIN_CLUSTER_REPORTS=1
# Optional theorem-output evidence override. Default 0 means verified
# theorem count alone does not trigger refresh unless you opt in.
# LLM_STEER_MIN_VERIFIED_THEOREMS=0
# Skip a due LLM strategy refresh when recent worker telemetry includes
# compact RL policy evidence showing both the GA workhorse policy and
# target-selector policy are sufficiently sampled and productive. This
# makes the 2h interval an upper bound: confident local RL keeps running
# without spending Gradient tokens.
# LLM_STEER_SKIP_IF_RL_CONFIDENT=1
# LLM_STEER_RL_CONFIDENT_MIN_REPORTS=3
# LLM_STEER_RL_CONFIDENT_MIN_EPISODES=8
# LLM_STEER_RL_CONFIDENT_MIN_SCORE=0.45
# LLM_STEER_RL_CONFIDENT_MIN_LAKE_PASS_RATE=0.25
# Optional cosmetic theorem naming. Disabled by default so the server
# Gradient key is only used for high-level steering. Enable only when
# you explicitly want per-theorem naming calls.
# LLM_NAMING_ENABLED=1
# NAMING_CONCURRENCY=1
# Optional: skip the steerer entirely (workers fall back to defaults)
# STEERER_DISABLED=1

# ── Local worker RL memory ─────────────────────────────────
# The worker learns mutation-operator rewards, quality-diversity cells,
# and strategy-genome ES/RL controller state locally. State is scoped by
# (domain,target), discounted over time, and discounted again when the
# local corpus size changes.
NASRUDIN_RL_HALF_LIFE_HOURS=168
# Optional override; default is ~/.local/share/nasrudin-worker/worker_rl_state.json
# NASRUDIN_WORKER_RL_STATE=/absolute/path/to/worker_rl_state.json
# Local JSONL replay buffer for offline RL/policy evaluation. Each
# background chunk appends observation/action/reward/verifier metrics.
# Default path is worker_rl_episodes.jsonl next to worker_rl_state.json.
# NASRUDIN_RL_EPISODE_LOG=1
# NASRUDIN_RL_EPISODE_LOG_PATH=/absolute/path/to/worker_rl_episodes.jsonl
# Automatically retain only the newest N JSONL episodes after scheduled
# evaluation refresh. Set 0 to disable retention.
# NASRUDIN_RL_EPISODE_LOG_MAX_LINES=100000
# Automatically refresh a compact JSON policy ranking from the episode
# log on worker chunk boundaries. This is enabled by default and runs
# on a cooldown, so no human or cron job has to trigger it. The worker
# also reads this snapshot back as a local GA-policy prior.
# NASRUDIN_RL_EPISODE_EVAL=1
# NASRUDIN_RL_EPISODE_EVAL_INTERVAL_SECONDS=1800
# NASRUDIN_RL_EPISODE_EVAL_PATH=/absolute/path/to/worker_rl_episode_eval.json
# NASRUDIN_RL_EPISODE_EVAL_MIN_PULLS=3
# Optional: let the worker choose targets from the local RL portfolio
# instead of pinning a single target. Equivalent CLI: --target auto.
# NASRUDIN_AUTO_TARGETS=1
# Recency weight for auto-target RL portfolio updates. Higher reacts
# faster to recent Lake/verifier outcomes; lower trusts long-run means.
# NASRUDIN_TARGET_RL_EMA_ALPHA=0.30
# Auto-target mode also learns which target-scoring policy to use:
# verifier_ucb, recent_verifier, novelty_seeker, or stall_rescue. This
# meta-controller is local RL state only; it does not call the LLM.
# The GA workhorse also has a local RL meta-controller over bounded
# per-chunk policies: steady_verify, wide_explore, deep_recombine,
# mutation_sweep, lake_focus. This adapts population, mutation,
# crossover, chain depth, and Lake budget from verifier reward without
# extra LLM calls.
# Locally verified chains are stored in a bounded prioritized replay
# archive and re-injected as elite seeds in future chunks. Replay
# entries track pulls/reward from later chunks, so the worker learns
# which proof-backed derivations are worth reusing. This is GA/RL
# memory, not LLM prompting. Disable only for ablation runs.
# NASRUDIN_REPLAY_ELITES=1
# NASRUDIN_REPLAY_ELITE_ARCHIVE_LIMIT=16
# NASRUDIN_REPLAY_ELITES_PER_CHUNK=4
# After this many consecutive no-proof chunks, an unproved target is
# reported as stalled and skipped so it cannot block frontier/novelty
# search forever. Raise if you want more patience per featured theorem.
# NASRUDIN_TARGET_RL_STALL_THRESHOLD=5
# Retry a stalled featured target after this cooldown, or sooner when
# the local corpus size changes. Set to 0 to keep stalled targets skipped
# until corpus drift makes them eligible again.
# NASRUDIN_TARGET_RL_STALL_RETRY_SECONDS=86400
# Load local PhysLean catalog facts into the worker hot tier when
# catalog.json is available. Safe loader skips non-propositional
# placeholders and known headline-result canonicals.
NASRUDIN_WORKER_LOAD_CATALOG=1
# Local development default: do not claim paid jobs unless explicitly enabled.
NASRUDIN_NO_PAID_JOBS=1

# ── MCP (future) ──────────────────────────────────────────
# MCP_PORT=3002

# ── Stripe billing ────────────────────────────────────────
# Test-mode keys from dashboard.stripe.com (Developers → API keys).
# When unset, /api/billing/* returns 503 and the rest of the API still works.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_RESEARCHER_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_RESEARCHER_ANNUAL=price_REPLACE_ME
# Sponsor tiers (recurring monthly donations — PlanTier::Free).
STRIPE_PRICE_SPONSOR_5=price_REPLACE_ME
STRIPE_PRICE_SPONSOR_25=price_REPLACE_ME
STRIPE_PRICE_SPONSOR_100=price_REPLACE_ME
# Pay-what-you-want one-time donation price (customer_adjustable amount).
# A single Stripe Price with `unit_amount=null` exposed via Checkout Session
# `mode=payment` + `submit_type=donate`. Renders an amount input on the
# hosted page. When unset the "Custom amount" sponsor tier 503s.
STRIPE_PRICE_SPONSOR_OPEN=price_REPLACE_ME
# Stripe Payment Link for one-time, name-your-amount donations.
STRIPE_SPONSOR_PAYMENT_LINK=https://buy.stripe.com/REPLACE_ME
# Backfill flag — when set to "1", the API at startup paginates every
# Stripe customer with a matching `users.stripe_customer_id`, fetches
# their active subscriptions + recent charges, and upserts into the
# `user_sponsorships` table. Opt-in to avoid hammering Stripe on each
# restart; only flip on after a fresh deploy where the table is empty.
BACKFILL_SPONSORSHIPS=0
STRIPE_CUSTOMER_PORTAL_RETURN_URL=http://localhost:3000/profile
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/profile?billing=ok
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/pricing?billing=cancelled

# ── Firebase Auth ─────────────────────────────────────────
# Backend: only the project ID is needed to verify Firebase ID tokens.
# When unset, /api/auth/firebase-session returns 503 and the rest of the
# API works (sign-in is unavailable, but worker keys and live API keys
# continue to function).
FIREBASE_PROJECT_ID=nasrudin

# Frontend (VITE_*): public per Firebase's threat model — safe in the bundle.
# Get them from console.firebase.google.com → Project settings → General →
# Your apps → Web → Firebase SDK snippet → Config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Admin panel + trust bypass ────────────────────────────
# Bearer token for admin endpoints when not signed-in via cookie session.
# Used by ops scripts and the bootstrap reconciler. Synthesizes the system
# actor for audit rows. When unset, only admin sessions can hit /api/admin/*.
ADMIN_TOKEN=

# Default 1-in-N spot-check rate for trusted submissions. NULL on the
# user/api_key column means "use this".
TRUSTED_SPOT_CHECK_RATE=50

# Unix-domain-socket path for the API's auto-trust listener. The
# co-located worker connects via `unix://...` and is treated as trusted
# by transport. Caddy never proxies to this socket. Empty string
# disables the listener (containers without /run sharing).
NASRUDIN_LOCAL_SOCK_PATH=/run/nasrudin/api-local.sock

# 64 hex bytes (32 raw). HMAC signing key for impersonation tokens.
# Generate with: openssl rand -hex 32
IMPERSONATION_SIGNING_KEY=

# Direct Stripe REST base URL (used by refund flow + reconciler).
# Override only for tests against a wiremock server.
STRIPE_BASE_URL=https://api.stripe.com
