# Physics Generator - Local Development Environment
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=physics
POSTGRES_PASSWORD=physics_dev
POSTGRES_DB=physics_generator
POSTGRES_PORT=5432

# Connection string used by Rust engine (SeaORM)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Rust Engine ────────────────────────────────────────────
RUST_LOG=info
API_PORT=3001
ROCKS_DB_PATH=./data/theorems.db

# ── Frontend ───────────────────────────────────────────────
VITE_API_URL=http://localhost:${API_PORT}
VITE_STRIPE_SPONSOR_PAYMENT_LINK=https://buy.stripe.com/REPLACE_ME

# ── LLM / MCP (future) ────────────────────────────────────
# LLM_API_KEY=
# LLM_MODEL=claude-sonnet-4-20250514
# MCP_PORT=3002

# ── Stripe billing ────────────────────────────────────────
# Test-mode keys from dashboard.stripe.com (Developers → API keys).
# When unset, /api/billing/* returns 503 and the rest of the API still works.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_RESEARCHER_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_RESEARCHER_ANNUAL=price_REPLACE_ME
# Sponsor tiers (recurring monthly donations — PlanTier::Free).
STRIPE_PRICE_SPONSOR_5=price_REPLACE_ME
STRIPE_PRICE_SPONSOR_25=price_REPLACE_ME
STRIPE_PRICE_SPONSOR_100=price_REPLACE_ME
# Stripe Payment Link for one-time, name-your-amount donations.
STRIPE_SPONSOR_PAYMENT_LINK=https://buy.stripe.com/REPLACE_ME
STRIPE_CUSTOMER_PORTAL_RETURN_URL=http://localhost:3000/profile
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/profile?billing=ok
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/pricing?billing=cancelled

# ── Firebase Auth ─────────────────────────────────────────
# Backend: only the project ID is needed to verify Firebase ID tokens.
# When unset, /api/auth/firebase-session returns 503 and the rest of the
# API works (sign-in is unavailable, but worker keys and live API keys
# continue to function).
FIREBASE_PROJECT_ID=nasrudin

# Frontend (VITE_*): public per Firebase's threat model — safe in the bundle.
# Get them from console.firebase.google.com → Project settings → General →
# Your apps → Web → Firebase SDK snippet → Config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
