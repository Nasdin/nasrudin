# Native (non-docker) Caddyfile for the nasrudin-prod droplet.
# Mirrors deploy/Caddyfile but reverse-proxies to localhost ports
# instead of docker service hostnames.
#
# Cloudflare presents edge TLS; Caddy presents valid LE cert at origin so
# Cloudflare's "Full (strict)" mode is satisfied. origin.nasrudin.org is the
# DNS-only emergency bypass.

nasrudin.org {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Serve hashed Vite client assets directly from disk — no SSR roundtrip
	# for /assets/* / favicon / pattern svgs. Falls through to the SSR
	# Node listener for everything else (HTML routes, API proxying via
	# the @api matcher would be, etc.).
	root * /opt/nasrudin/frontend/client
	@static_file file
	handle @static_file {
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}
	handle {
		reverse_proxy 127.0.0.1:3000
		# index.html (and all SSR routes) must not be cached by browsers
		# or Cloudflare. Hash-suffixed assets under /assets/* live forever
		# (handled above), but the HTML that references those hashes has
		# to refresh on every load — otherwise a tab open through a deploy
		# tries to dynamic-import old chunk hashes that no longer exist
		# and trips "Failed to fetch dynamically imported module".
		header Cache-Control "no-cache, must-revalidate"
	}
}

api.nasrudin.org {
	# SSE streams must not buffer — `flush_interval -1` flushes immediately,
	# bypassing reverse-proxy and CDN buffering.
	@sse path /api/events/*
	handle @sse {
		reverse_proxy 127.0.0.1:3001 {
			flush_interval -1
			# Strip upstream CORS — Caddy is the source of truth for prod origin.
			# (axum CorsLayer in the API still ships dev's localhost:3000 origin
			# until the next Rust rebuild swaps it for an env-driven value.)
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Credentials
			header_down -Access-Control-Allow-Methods
			header_down -Access-Control-Allow-Headers
		}
	}
	reverse_proxy 127.0.0.1:3001 {
		header_down -Access-Control-Allow-Origin
		header_down -Access-Control-Allow-Credentials
		header_down -Access-Control-Allow-Methods
		header_down -Access-Control-Allow-Headers
	}
	header Access-Control-Allow-Origin "https://nasrudin.org"
	header Access-Control-Allow-Credentials "true"
	header Access-Control-Allow-Methods "GET, POST, DELETE, OPTIONS"
	header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, Cookie"
}

# Cloudflare-grey emergency bypass — DNS-only, hits the droplet directly.
origin.nasrudin.org {
	reverse_proxy 127.0.0.1:3001
}
