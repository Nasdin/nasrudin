[Unit]
Description=Nasrudin Physics API
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=nasrudin
Group=nasrudin
WorkingDirectory=/opt/nasrudin
EnvironmentFile=/opt/nasrudin/.env
Environment=PROVER_ROOT=/opt/nasrudin/prover
Environment=LAKE_WORKSPACE_ROOT=/var/lib/nasrudin/lake-cache
Environment=ROCKS_DB_PATH=/var/lib/nasrudin/rocks
Environment=ELAN_HOME=/opt/nasrudin/elan
Environment=PATH=/opt/nasrudin/elan/bin:/usr/local/bin:/usr/bin:/bin
# fastembed → ort dynamically loads `libonnxruntime.so.1.21` (Debian
# trixie's libonnxruntime-dev package). Ubuntu 24.04 doesn't ship that
# package in apt, so build-release.sh bundles the .so chain from the
# build container into /opt/nasrudin/lib/. Pinning LD_LIBRARY_PATH here
# is what lets the dynamic linker find it at exec time.
Environment=LD_LIBRARY_PATH=/opt/nasrudin/lib
Environment=CORS_ALLOWED_ORIGIN=https://nasrudin.org
# Admin panel + trust bypass.
Environment=TRUSTED_SPOT_CHECK_RATE=50
Environment=NASRUDIN_LOCAL_SOCK_PATH=/run/nasrudin/api-local.sock
Environment=STRIPE_BASE_URL=https://api.stripe.com
# IMPERSONATION_SIGNING_KEY (64 hex bytes), ADMIN_TOKEN, STRIPE_*
# come from /opt/nasrudin/.env via EnvironmentFile above.
RuntimeDirectory=nasrudin
RuntimeDirectoryMode=0755
# WITHOUT this, systemd cleans /run/nasrudin/ when this unit stops, and
# the elaborator's long-lived elab.sock gets wiped as collateral damage
# even though nasrudin-elaborator.service is still running. Workers
# then hang forever in "Connecting to elaborator daemon /run/nasrudin/elab.sock"
# until the elaborator is manually restarted (~25 min cold-boot). See
# the May 3 zombie incident: api restart → socket gone → worker stuck
# for 22 days.
RuntimeDirectoryPreserve=yes
ExecStart=/opt/nasrudin/bin/physics-api
Restart=on-failure
RestartSec=10
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
