# Phase 9 deploy environment template.
# Copy to /opt/nasrudin/deploy/.env and run scripts/bootstrap.sh to populate __GEN__ values.

# ── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_USER=physics
POSTGRES_DB=physics_generator
POSTGRES_PASSWORD=__GEN__

# ── Worker bootstrap ───────────────────────────────────────────────────────
# Issued by `docker compose run --rm api /usr/local/bin/issue-worker-key`
# at first boot, then written back into this file.
NASRUDIN_INTERNAL_WORKER_KEY=__GEN__

# Used by the backfill_existing_lean binary at first boot to ingest the
# committed reference proofs.
NASRUDIN_BACKFILL_KEY=__GEN__

# ── Public URLs ────────────────────────────────────────────────────────────
NASRUDIN_API_PUBLIC_URL=https://api.nasrudin.org
NASRUDIN_FRONTEND_PUBLIC_URL=https://nasrudin.org

# ── Auth secrets ───────────────────────────────────────────────────────────
SESSION_SECRET=__GEN__
ARGON2_PEPPER=__GEN__

# ── Admin (corpus reload) ──────────────────────────────────────────────────
# Bearer token for `POST /api/admin/reload_corpus`. cron-refresh.sh uses
# this to hot-reload the AxiomStore after a fresh `lake exe extract`.
# Generate via: openssl rand -hex 32
ADMIN_TOKEN=__GEN__

# ── Spaces backup ──────────────────────────────────────────────────────────
DO_SPACES_BUCKET=nasrudin-backups
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# rclone reads /etc/rclone.conf from the backup container, mounted from
# deploy/rclone.conf — copy rclone.conf.example to rclone.conf and fill in.

# ── Stripe billing (LIVE mode) ─────────────────────────────────────────────
# All STRIPE_* and VITE_STRIPE_* values live in the gitignored
# `deploy/.env` (real droplet) and the gitignored `.env` (root, for
# `just dev-engine`). Never commit price IDs, payment-link URLs, secret
# keys, or webhook secrets — this repo is public.
#
# Production rollout steps live in `docs/BILLING.md`. The shape of what
# goes in `deploy/.env` is:
#
#   STRIPE_SECRET_KEY=sk_live_…
#   STRIPE_WEBHOOK_SECRET=whsec_…
#   STRIPE_PRICE_RESEARCHER_MONTHLY=price_…
#   STRIPE_PRICE_RESEARCHER_ANNUAL=price_…
#   STRIPE_PRICE_SPONSOR_5=price_…
#   STRIPE_PRICE_SPONSOR_25=price_…
#   STRIPE_PRICE_SPONSOR_100=price_…
#   STRIPE_SPONSOR_PAYMENT_LINK=https://donate.stripe.com/…
#   STRIPE_CUSTOMER_PORTAL_RETURN_URL=https://nasrudin.org/profile
#   STRIPE_CHECKOUT_SUCCESS_URL=https://nasrudin.org/profile?billing=ok
#   STRIPE_CHECKOUT_CANCEL_URL=https://nasrudin.org/pricing?billing=cancelled
#   VITE_STRIPE_SPONSOR_PAYMENT_LINK=https://donate.stripe.com/…
